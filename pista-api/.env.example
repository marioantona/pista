# Copy to .env and fill in. The real .env lives only on the server at
# ~/pista-api/.env with 0600 permissions and is never committed.
#
# SerpAPI key — https://serpapi.com/manage-api-key
# Read at module scope by api.js, so dotenv must load before any other
# require in server.js.
SERPAPI_KEY=

# Shared HMAC secret for the X-PISTA-Token handshake (RUNBOOK section 6/17).
# MUST be byte-identical to PISTA_API_SECRET in /var/www/pista.env.
# Generate with: openssl rand -hex 32   (hex, so neither .env parser meets + / =)
PISTA_API_SECRET=

# Optional. During rotation, the old secret goes here so tokens PHP minted
# before its own restart still verify. Remove once both sides use the new one.
# PISTA_API_SECRET_PREVIOUS=

# Optional. 'true' rejects requests without a valid token (401). Anything else,
# including unset, only LOGS token validity -- the staged-rollout mode.
# TOKEN_ENFORCE=false
